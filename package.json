{
  "name": "spine-viewer",
  "displayName": "Spine Viewer",
  "description": "Browse and preview Spine skeleton animations from the current VS Code workspace.",
  "version": "0.0.1",
  "publisher": "local",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "spine",
    "pixi",
    "animation",
    "preview",
    "webp",
    "atlas"
  ],
  "activationEvents": [
    "onCommand:spineViewer.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spineViewer.open",
        "title": "Spine Viewer: Open Spine Browser"
      }
    ]
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "4.2.74",
    "pixi.js": "8.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build"
  }
}
