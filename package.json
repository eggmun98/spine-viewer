{
  "name": "spine-viewer",
  "displayName": "Spine Viewer",
  "description": "Browse and preview Spine skeleton animations from the current VS Code workspace.",
  "version": "0.1.0",
  "publisher": "eggmun",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eggmun98/spine-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/eggmun98/spine-viewer/issues"
  },
  "homepage": "https://github.com/eggmun98/spine-viewer#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "spine",
    "pixi",
    "animation",
    "preview",
    "webp",
    "atlas"
  ],
  "activationEvents": [
    "onView:spineViewer.tree"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spineViewer",
          "title": "Spine Viewer",
          "icon": "media/spine-activity.svg"
        }
      ]
    },
    "views": {
      "spineViewer": [
        {
          "id": "spineViewer.tree",
          "name": "Skeletons",
          "icon": "media/spine-activity.svg",
          "contextualTitle": "Spine Viewer"
        }
      ]
    },
    "commands": [
      {
        "command": "spineViewer.open",
        "title": "Focus Skeleton List",
        "category": "Spine Viewer"
      },
      {
        "command": "spineViewer.refresh",
        "title": "Refresh",
        "category": "Spine Viewer",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "spineViewer.refresh",
          "when": "view == spineViewer.tree",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "spineViewer.refresh",
          "when": "true"
        }
      ]
    }
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "4.2.74",
    "pixi.js": "8.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build"
  }
}
